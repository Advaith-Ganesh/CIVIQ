generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "sqlite"
 url = env("DATABASE_URL")
}
model Actor {
 id String @id @default(cuid())
 name String
 role String
 events Event[]
}
model Category {
 id String @id
 name String
 keywords String
 active Boolean @default(true)
 teamId String?
 team Team? @relation(fields: [teamId], references: [id])
 issues Issue[]
}
model Team {
 id String @id @default(cuid())
 name String @unique
 area String
 categories Category[]
 assignments Assignment[]
}
model Issue {
 id String @id @default(cuid())
 title String
 description String
 categoryId String
 category Category @relation(fields: [categoryId], references: [id])
 lat Float
 lng Float
 location String
 status String @default("Submitted")
 severity Int
 priority Int
 override Int?
 context Float @default(0.5)
 synthetic Boolean @default(false)
 dataType String @default("USER_SUBMITTED")
 sourceId String?
 originalRecordId String?
 referenceDate DateTime?
 importedAt DateTime?
 accessibility String @default("[]")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 closedAt DateTime?
 @@index([categoryId, status, createdAt])
 @@index([lat, lng])
 reports Report[]
 assessments Assessment[]
 matches DuplicateMatch[]
 assignments Assignment[]
 events Event[]
 repairs RepairEvidence[]
}
model Report {
 id String @id @default(cuid())
 reference String @unique
 issueId String
 issue Issue @relation(fields: [issueId], references: [id])
 description String
 lat Float
 lng Float
 synthetic Boolean @default(false)
 dataType String @default("USER_SUBMITTED")
 sourceId String?
 originalRecordId String?
 referenceDate DateTime?
 importedAt DateTime?
 accessibility String @default("[]")
 createdAt DateTime @default(now())
 photographs Photograph[]
 matches DuplicateMatch[]
}
model Photograph {
 id String @id @default(cuid())
 dataType String @default("USER_SUBMITTED")
 sourceId String?
 originalRecordId String?
 path String
 mime String
 reportId String?
 report Report? @relation(fields: [reportId], references: [id])
 repair RepairEvidence?
 createdAt DateTime @default(now())
 analyses ImageAnalysis[]
}
model Assessment {
 id String @id @default(cuid())
 issueId String
 issue Issue @relation(fields: [issueId], references: [id])
 provider String
 confidence Float
 explanation String
 createdAt DateTime @default(now())
}
model DuplicateMatch {
 id String @id @default(cuid())
 reportId String
 report Report @relation(fields: [reportId], references: [id])
 issueId String
 issue Issue @relation(fields: [issueId], references: [id])
 score Float
 distance Float
 explanation String
 decision String @default("Pending")
 createdAt DateTime @default(now())
}
model Assignment {
 id String @id @default(cuid())
 issueId String
 issue Issue @relation(fields: [issueId], references: [id])
 teamId String
 team Team @relation(fields: [teamId], references: [id])
 scheduledAt DateTime?
 createdAt DateTime @default(now())
}
model Event {
 id String @id @default(cuid())
 issueId String
 issue Issue @relation(fields: [issueId], references: [id])
 actorId String
 actor Actor @relation(fields: [actorId], references: [id])
 kind String
 message String
 public Boolean @default(true)
 createdAt DateTime @default(now())
}
model RepairEvidence {
 id String @id @default(cuid())
 issueId String
 issue Issue @relation(fields: [issueId], references: [id])
 photographId String @unique
 photograph Photograph @relation(fields: [photographId], references: [id])
 outcome String
 verified Boolean @default(false)
 createdAt DateTime @default(now())
}
model DatasetSource {
 id String @id
 title String
 url String
 period String
 retrievedAt DateTime
 note String
 dataType String @default("OFFICIAL_AGGREGATE")
 licence String @default("Reuse terms unverified; attribution link only")
 coverage String @default("Southampton")
 originalRecordId String?
 importDate DateTime @default(now())
 status String @default("metadata_only")
 importedCount Int @default(0)
 payload String @default("{}")
 records ImportedRecord[]
}
model Setting {
 id String @id
 value String
}

model ImageAnalysis {
 id String @id @default(cuid())
 photographId String
 photograph Photograph @relation(fields: [photographId], references: [id])
 provider String
 modelId String?
 revision String?
 status String
 categoryId String?
 abstained Boolean @default(true)
 durationMs Float?
 result String
 correctedCategoryId String?
 createdAt DateTime @default(now())
 @@index([photographId, createdAt])
}
model TextEmbedding {
 id String @id
 modelId String
 revision String
 vector String
 createdAt DateTime @default(now())
}
model ImportedRecord {
 id String @id @default(cuid())
 sourceId String
 source DatasetSource @relation(fields: [sourceId], references: [id])
 originalRecordId String
 dataType String
 referenceDate DateTime
 importedAt DateTime @default(now())
 payload String
 @@unique([sourceId, originalRecordId])
}
model ModelEvaluation {
 id String @id @default(cuid())
 modelId String
 revision String
 dataset String
 sampleSize Int
 result String
 evaluatedAt DateTime
}
